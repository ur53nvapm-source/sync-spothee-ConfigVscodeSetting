// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+a",
    "command": "workbench.action.terminal.selectAll",
  },
  {
    "key": "ctrl+shift+a",
    "command": "editor.action.selectAll",
  },
  {
    "key": "ctrl+a",
    "command": "-editor.action.selectAll",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.terminal.clear",
  },
]
