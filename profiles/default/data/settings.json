    "sideBarStickyScroll.background": "#202020cc", // ? sideBarStickyScroll - Nền sidebar - #202020 (80%)
    "panelStickyScroll.background": "#202020cc", // ? panelStickyScroll - Nền panel - #202020 (80%)
