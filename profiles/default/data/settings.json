    "editorBracketHighlight.foreground1": "#5c9bd6d8", // ? foreground1 - Cấp 1 - Xanh dương
    "editorBracketHighlight.foreground2": "#d19a66", // ? foreground2 - Cấp 2 - Cam
    "editorBracketHighlight.foreground3": "#98c379", // ? foreground3 - Cấp 3 - Xanh lá
    "editorBracketHighlight.foreground4": "#c678dd", // ? foreground4 - Cấp 4 - Tím
    "editorBracketHighlight.foreground5": "#e06c75", // ? foreground5 - Cấp 5 - Hồng
    "editorBracketHighlight.foreground6": "#56b6c2", // ? foreground6 - Cấp 6 - Cyan
    "editorBracketHighlight.unexpectedBracket.foreground": "#e06c75", // ! unexpectedBracket - Ngoặc lỗi - Hồng
    "editorBracketMatch.background": "#00000000", // ! editorBracketMatch.background - Nền ngoặc khớp - Ẩn
    "editorBracketMatch.border": "#00000000", // ! editorBracketMatch.border - Viền ngoặc khớp - Ẩn
    // Diagnostics
    "editorError.foreground": "#e06c75", // ! editorError.foreground - Lỗi - Đỏ
    "editorWarning.foreground": "#00000000", // ! editorWarning.foreground - Cảnh báo - Ẩn
    "editorInfo.foreground": "#00000000", // ! editorInfo.foreground - Thông tin - Ẩn
    "editorHint.foreground": "#00000000", // ! editorHint.foreground - Gợi ý - Ẩn
