    "scmGraph.historyItemHoverDefaultLabelForeground": "#171717", // ? Chữ đậm
    "scmGraph.historyItemHoverDefaultLabelBackground": "#ebdbb284" // ? Nền vàng nhạt Gruvbox
  },
  // * ------------------------------------------------------------
  // * [`04].EDITOR - Hiển thị, con trỏ, minimap và guide
  // * ------------------------------------------------------------
  "editor.fontFamily": "'Cascadia Code', 'Ubuntu Mono', 'DejaVu Sans Mono', monospace", // ? fontFamily - Font chữ - Hỗ trợ Win/Linux
  "editor.fontLigatures": false, // ! fontLigatures - Gộp ký tự - Tắt
  "editor.fontVariations": false, // ! fontVariations - Biến thể font - Tắt
  "editor.lineNumbers": "on", // ? lineNumbers - Số dòng - Tuyệt đối
  "editor.wordWrap": "on", // ? wordWrap - Xuống dòng - Bật
  "editor.cursorWidth": 3, // ? cursorWidth - Độ rộng con trỏ - 3px
  "editor.cursorHeight": 100, // ? cursorHeight - Chiều cao con trỏ - 100%
  "editor.cursorBlinking": "solid", // ! cursorBlinking - Nhấp nháy - Tắt
  "editor.renderLineHighlight": "none", // ! renderLineHighlight - Tô nền dòng - Tắt
  "editor.renderLineHighlightOnlyWhenFocus": true, // ? renderLineHighlightOnlyWhenFocus - Tô nền dòng - Chỉ khi focus
  "editor.renderWhitespace": "none", // ! renderWhitespace - Khoảng trắng - Ẩn
  "editor.occurrencesHighlightDelay": 200, // ? occurrencesHighlightDelay - Delay highlight - 200ms
  "editor.minimap.enabled": true, // ? minimap.enabled - Minimap - Bật
  "editor.minimap.renderCharacters": false, // ! renderCharacters - Ký tự minimap - Tắt
  "editor.minimap.maxColumn": 80, // ? maxColumn - Cột tối đa - 80
  "editor.minimap.showSlider": "always", // ? showSlider - Thanh trượt - Luôn hiện
  "editor.stickyScroll.enabled": false, // ! stickyScroll.enabled - Sticky scroll - Tắt
  "editor.stickyScroll.scrollWithEditor": false, // ! scrollWithEditor - Cuộn sticky - Tắt
  "editor.guides.bracketPairs": "active", // ? guides.bracketPairs - Guide ngoặc - Active
  "editor.guides.bracketPairsHorizontal": false, // ! bracketPairsHorizontal - Guide ngang - Tắt
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true, // ? independentColorPoolPerBracketType - Màu ngoặc - Độc lập
  "editor.linkedEditing": true, // * linkedEditing - Sửa thẻ HTML - Bật
  "editor.hover.delay": 500, // ? hover.delay - Delay tooltip - 500ms
  "editor.hover.sticky": true, // ? hover.sticky - Tooltip dính - Bật
  "editor.lightbulb.enabled": "off", // ! lightbulb.enabled - Bóng đèn gợi ý - Tắt
  "editor.codeLens": false, // ! codeLens - CodeLens - Tắt
  "breadcrumbs.filePath": "last", // ? breadcrumbs.filePath - Breadcrumb - Tên file cuối
  "editor.semanticTokenColorCustomizations": {
    "enabled": true // * enabled - Màu ngữ nghĩa - Bật
  },
  // * ------------------------------------------------------------
  // * [`05].TERMINAL - Shell, font chữ, lịch sử lệnh
  // * ------------------------------------------------------------
  "terminal.integrated.fontFamily": "'Cascadia Code', 'JetBrains Mono', 'Ubuntu Mono', 'DejaVu Sans Mono', Consolas, monospace", // ? fontFamily - Font chữ - Hỗ trợ Win/Linux
  "terminal.integrated.fontSize": 16, // ? fontSize - Cỡ chữ - 16px
  "terminal.integrated.fontWeight": "251", // ! fontWeight - Độ đậm - Light
  "terminal.integrated.fontWeightBold": "251", // ! fontWeightBold - Độ đậm Bold - Extra Light (200)
  "terminal.integrated.lineHeight": 1.3, // ? lineHeight - Chiều cao dòng - 130%
  "terminal.integrated.letterSpacing": 1.25, // ? letterSpacing - Khoảng cách chữ - 1.25px
  "terminal.integrated.defaultProfile.windows": "Git Bash", // * defaultProfile.windows - Shell Win - Git Bash
  "terminal.integrated.defaultProfile.linux": "bash", // * defaultProfile.linux - Shell Linux - Bash
  "terminal.integrated.gpuAcceleration": "on", // * gpuAcceleration - Tăng tốc GPU - Bật
  "terminal.integrated.smoothScrolling": false, // ! smoothScrolling - Cuộn mượt - Tắt
  "terminal.integrated.fastScrollSensitivity": 5, // ? fastScrollSensitivity - Cuộn nhanh - x5
  "terminal.integrated.scrollback": 10000, // ? scrollback - Lịch sử - 10000 dòng
  "terminal.integrated.enablePersistentSessions": false, // ! enablePersistentSessions - Giữ session - Tắt
  "terminal.integrated.persistentSessionReviveProcess": "never", // ! persistentSessionReviveProcess - Phục hồi - Không
  "terminal.integrated.cursorStyle": "line", // ? cursorStyle - Con trỏ - Dòng
  "terminal.integrated.copyOnSelection": true, // * copyOnSelection - Tự copy - Bật
  "terminal.integrated.stickyScroll.enabled": false, // ! stickyScroll - Sticky scroll - Tắt
  "terminal.integrated.initialHint": false, // ! initialHint - Gợi ý phím - Tắt
  "terminal.integrated.env.windows": {
    "CHCP": "65001" // * CHCP - Mã hóa - UTF-8
  },
  // * ------------------------------------------------------------
  // * [`06].SUGGEST - Bảng gợi ý code (IntelliSense)
  // * ------------------------------------------------------------
  "editor.quickSuggestions": {
    "comments": false, // ! comments - Gợi ý comment - Tắt
    "strings": true, // ? strings - Gợi ý string - Bật
    "other": true // ? other - Gợi ý code - Bật
  },
  "editor.suggestOnTriggerCharacters": true, // * suggestOnTriggerCharacters - Gợi ý ký tự đặc biệt - Bật
  "editor.suggest.showStatusBar": true, // ? showStatusBar - Status bar gợi ý - Hiện
  "editor.suggest.localityBonus": true, // ? localityBonus - Ưu tiên gần - Bật
  "editor.suggestSelection": "recentlyUsed", // ? suggestSelection - Ưu tiên - Vừa dùng
  "editor.suggestFontSize": 16, // ? suggestFontSize - Cỡ chữ - 16px
  "editor.suggestLineHeight": 20, // ? suggestLineHeight - Chiều cao dòng - 20px
  "editor.suggest.maxVisibleSuggestions": 20, // ? maxVisibleSuggestions - Số gợi ý - 20
  "editor.acceptSuggestionOnCommitCharacter": false, // ! acceptSuggestionOnCommitCharacter - Tự chọn - Tắt
  "editor.inlineSuggest.enabled": true, // * inlineSuggest.enabled - Gợi ý inline - Bật
  // * ------------------------------------------------------------
  // * [`07].FILES & EXPLORER - Quản lý file, tìm kiếm, loại trừ
  // * ------------------------------------------------------------
  "editor.largeFileOptimizations": true, // ! largeFileOptimizations - Tối ưu file lớn - Bật
  "editor.maxTokenizationLineLength": 20000, // ! maxTokenizationLineLength - Giới hạn token - 20000
  "search.followSymlinks": false, // ! followSymlinks - Theo symlink - Tắt
  "search.useIgnoreFiles": true, // ? useIgnoreFiles - Tôn trọng gitignore - Bật
  "explorer.compactFolders": false, // ! compactFolders - Gộp folder - Tắt
  "explorer.fileNesting.enabled": true, // ? fileNesting.enabled - Gộp file - Bật
  "explorer.fileNesting.expand": false, // ? fileNesting.expand - Mở rộng - Tắt
  "files.exclude": {
    "**/.git": false, // ? Hiện thư mục .git
    "**/.svn": false, // ? Hiện thư mục .svn
    "**/.hg": false, // ? Hiện thư mục .hg
