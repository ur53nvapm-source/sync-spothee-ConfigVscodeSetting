{
  //`start v001 profile: default
  // * ============================================================
  // * Config VSCODE - SETTINGS.JSON
  // * @author: apm | partner: AI | version: beta v0.1
  // * Theme: Gruvbox Material Dark | Mode: Power Saving
  // * ============================================================
  // * MỤC LỤC - Menu
  // * ───────────────────────────────────────────────────────────
  // * [`01].QUICK TOGGLE      - Cài đặt thay đổi nhanh (Theme, Font, Zoom)
  // * [`02].WORKBENCH         - Bố cục, tab, sidebar và hiệu ứng UI
  // * [`03].COLOR             - Tùy chỉnh màu sắc giao diện (Glassmorphism)
  // * [`04].EDITOR            - Hiển thị, con trỏ, minimap và guide
  // * [`05].TERMINAL          - Shell, font chữ, lịch sử lệnh
  // * [`06].SUGGEST           - Bảng gợi ý code (IntelliSense)
  // * [`07].FILES & EXPLORER  - Quản lý file, tìm kiếm, loại trừ
  // * [`08].GIT               - Cấu hình Git, Sync Settings
  // * [`09].MISC & AI         - Cài đặt AI, Chat, Debug, ErrorLens
  // * [`10].TELEMETRY         - Dữ liệu, bảo mật, cập nhật extension
  // * [`11].EXTENSION         - Cấu hình riêng cho các extension
  // * ============================================================
  // * ------------------------------------------------------------
  // * CẤU HÌNH BETTER COMMENTS (Tag màu cho comment) - [`11].Extension
  // * ------------------------------------------------------------
  "better-comments.tags": [
    {
      "tag": "*", // * - Heading - Xanh lá (Tiêu đề)
      "color": "#a9b665",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "?", // ? - Info - Xanh dương (Thông tin)
      "color": "#7daea3",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "!", // ! - Warning - Đỏ (Cảnh báo)
      "color": "#ea6962",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "TODO", // TODO - Task - Cam (Việc cần làm)
      "color": "#e78a4e",
      "strikethrough": false,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": true
    },
    {
      "tag": "//", // // - Disabled - Xám (Code cũ, tạm ẩn)
      "color": "#928374",
      "strikethrough": true,
      "underline": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    }
  ],
  // * ------------------------------------------------------------
  // * [`01].QUICK TOGGLE - Cài đặt thay đổi nhanh (Theme, Font, Zoom)
  // * ------------------------------------------------------------
  "workbench.colorTheme": "Best Themes - Gruvbox Material Dark", // ? colorTheme - Giao diện - Gruvbox Dark
  "workbench.iconTheme": "file-icons", // ? iconTheme - Icon - File Icons
  "glassit.alpha": 249, // * alpha - Độ trong suốt cửa sổ - 249/255
  "window.zoomLevel": -0.6, // ? zoomLevel - Thu nhỏ UI
  "editor.fontSize": 14.855, // ? fontSize - Cỡ chữ editor
  "editor.fontWeight": "251", // ! fontWeight - Độ đậm chữ - Light
  "editor.lineHeight": 1.9755, // ? lineHeight - Chiều cao dòng - 197.5%
  "editor.letterSpacing": 1.25, // ? letterSpacing - Khoảng cách chữ - 1.25px
  // * ------------------------------------------------------------
  // * [`02].WORKBENCH - Bố cục, tab, sidebar và hiệu ứng UI
  // * ------------------------------------------------------------
  "workbench.startupEditor": "welcomePageInEmptyWorkbench", // ? startupEditor - Khởi động - Welcome Page
  "workbench.editor.enablePreview": false, // * enablePreview - Tab - Mở tab thật
  "workbench.editor.wrapTabs": true, // ? wrapTabs - Tab - Tự động xuống dòng
  "workbench.editor.showTabs": "multiple", // ? showTabs - Tab - Hiển thị nhiều tab
  "workbench.editor.limit.enabled": true, // ! limit.enabled - Giới hạn tab - Bật (Tiết kiệm RAM)
  "workbench.editor.limit.value": 20, // ? limit.value - Giới hạn tab - Tối đa 20
  "workbench.editor.limit.excludeDirty": true, // ! limit.excludeDirty - Giới hạn tab - Giữ tab chưa lưu
  "workbench.sideBar.location": "right", // ? sideBar.location - Sidebar - Bên phải
  "workbench.activityBar.compact": true, // ? activityBar.compact - Thanh hoạt động - Thu gọn
  "workbench.tree.indent": 19, // ? tree.indent - Thụt lề cây - 19px
  "workbench.tree.renderIndentGuides": "always", // ? renderIndentGuides - Đường kẻ - Luôn hiện
  "workbench.tree.enableStickyScroll": false, // ! tree.stickyScroll - Cây thư mục - Tắt ghim
  "workbench.list.smoothScrolling": false, // ! list.smoothScrolling - Cuộn mượt - Tắt (Đỡ CPU)
  "workbench.list.horizontalScrolling": false, // ! list.horizontalScrolling - Cuộn ngang - Tắt
  "workbench.reduceMotion": "on", // ! reduceMotion - Hiệu ứng động - Giảm (Đỡ GPU)
  "workbench.browser.showInTitleBar": true, // ? browser.showInTitleBar - Trình duyệt - Hiện trên Title Bar
  "workbench.editor.showIcons": true, // ? editor.showIcons - Icon tab - Hiện
  "workbench.navigationControl.enabled": true, // ? navigationControl - Điều hướng - Hiện nút Back/Forward
  "workbench.experimental.share.enabled": true, // ? share.enabled - Chia sẻ không gian làm việc
  "window.titleBarStyle": "custom", // ? titleBarStyle - Title bar - Tự vẽ
  "window.controlsStyle": "custom", // ? controlsStyle - Nút điều khiển - Tự vẽ
  "window.menuBarVisibility": "compact", // ? menuBarVisibility - Thanh menu - Thu gọn
  "window.autoDetectColorScheme": false, // ? autoDetectColorScheme - Theme OS - Tắt tự đổi
  "window.systemColorTheme": "dark", // ? systemColorTheme - Theme OS - Tối
  "window.density.layout": "compact", // ? density.layout - Bố cục - Thon gọn
  "window.customMenuBarAltFocus": true, // ? customMenuBarAltFocus - Menu bar - Nhấn Alt để hiện
  "update.mode": "manual", // ! update.mode - Cập nhật - Thủ công
  // * ------------------------------------------------------------
  // * [`03].COLOR - Tùy chỉnh màu sắc giao diện (Glassmorphism)
  // * ------------------------------------------------------------
  "workbench.colorCustomizations": {
    // Nền chính - Primary Background
    "editor.background": "#202020cc", // ? editor.background - Nền editor - #202020 (80%)
    "editorPane.background": "#20202000", // ? editorPane.background - Nền pane - Trong suốt
    "sideBar.background": "#202020cc", // ? sideBar.background - Nền sidebar - #202020 (80%)
    "sideBarTitle.background": "#202020cc", // ? sideBarTitle.background - Nền tiêu đề - #202020 (80%)
    "sideBar.foreground": "#9aa3ab", // ? sideBar.foreground - Chữ sidebar - #9aa3ab
    "activityBar.background": "#202020cc", // ? activityBar.background - Nền activity - #202020 (80%)
    "panel.background": "#20202000", // ? panel.background - Nền panel - Trong suốt
    "terminal.background": "#00000000", // ? terminal.background - Nền terminal - Trong suốt
    "minimap.background": "#202020cc", // ? minimap.background - Nền minimap - #202020 (80%)
    // Tab
    "tab.activeBackground": "#20202000", // ? tab.activeBackground - Tab active - Trong suốt
    "tab.inactiveBackground": "#202020cc", // ? tab.inactiveBackground - Tab inactive - #202020 (80%)
    "tab.unfocusedActiveBackground": "#20202000", // ? tab.unfocusedActiveBackground - Tab active (mất focus) - Trong suốt
    "tab.unfocusedInactiveBackground": "#202020cc", // ? tab.unfocusedInactiveBackground - Tab inactive (mất focus) - #202020 (80%)
    "tab.border": "#00000000", // ! tab.border - Viền tab - Ẩn
    "tab.activeBorder": "#00000000", // ! tab.activeBorder - Viền dưới tab active - Ẩn
    "tab.activeBorderTop": "#5c9cd6", // * tab.activeBorderTop - Vạch trên tab active - #5c9cd6
    "tab.activeForeground": "#b0b8c0", // ? tab.activeForeground - Chữ tab active - #b0b8c0
    "tab.inactiveForeground": "#78828b", // ? tab.inactiveForeground - Chữ tab inactive - #78828b
    "editorGroupHeader.tabsBackground": "#20202000", // ? tabsBackground - Nền vùng chứa tab - Trong suốt
    "editorGroupHeader.noTabsBackground": "#20202000", // ? noTabsBackground - Nền không có tab - Trong suốt
    "editorGroupHeader.border": "#00000000", // ! editorGroupHeader.border - Viền vùng chứa tab - Ẩn
    "editorGroup.border": "#3c3c3c80", // ? editorGroup.border - Viền nhóm editor - #3c3c3c (50%)
    // Breadcrumb / Gutter / Line
    "breadcrumb.background": "#20202000", // ? breadcrumb.background - Nền breadcrumb - Trong suốt
    "editorGutter.background": "#00000000", // ? editorGutter.background - Nền gutter - Trong suốt
    "editor.lineHighlightBackground": "#ffffff0d", // ? lineHighlightBackground - Nền dòng hiện tại - #ffffff (5%)
    "editor.lineHighlightBorder": "#00000000", // ! lineHighlightBorder - Viền dòng hiện tại - Ẩn
    // Widget / Popup / Menu
    "editorWidget.background": "#2d2d2de6", // ? editorWidget.background - Nền widget - #2d2d2d (90%)
