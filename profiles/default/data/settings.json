  // * ------------------------------------------------------------
  // * [`08].GIT - Cấu hình Git, Sync Settings
  // * ------------------------------------------------------------
  "git.enableSmartCommit": false, // ! enableSmartCommit - Commit không stage - Tắt
  "git.confirmSync": false, // ! confirmSync - Xác nhận sync - Tắt
  "git.autofetch": false, // ! autofetch - Tự fetch - Tắt
  "git.autofetchPeriod": 180, // ? autofetchPeriod - Chu kỳ fetch -  180s
  "git.openRepositoryInParentFolders": "never", // ! openRepositoryInParentFolders - Mở repo cha - Không
  // ! Windows SSH Path: Dùng Linux thì comment dòng dưới
  "git.sshCommand": "C:\\Program Files\\Git\\usr\\bin\\ssh.exe", // ! sshCommand - SSH - Windows Path
  // * ------------------------------------------------------------
  // * [`09].MISC & AI - Cài đặt AI, Chat, Debug, ErrorLens
  // * ------------------------------------------------------------
  "diffEditor.ignoreTrimWhitespace": false, // ! ignoreTrimWhitespace - Diff khoảng trắng - Bật
  "problems.showCurrentInStatus": true, // ? showCurrentInStatus - Lỗi status bar - Hiện
  "markdown.preview.fontFamily": "-apple-system, 'Segoe UI', sans-serif", // ? preview.fontFamily - Font markdown - System
  "debug.console.fontFamily": "'Cascadia Code', Consolas, monospace", // ? console.fontFamily - Font debug - Cascadia
  "debug.console.fontSize": 13, // ? console.fontSize - Cỡ chữ debug - 13px
  // AI & Chat Configs
  "chat.disableAIFeatures": false, // * disableAIFeatures - Tắt toàn bộ AI (Giữ false để dùng Chat)
  "chat.stickyScroll.enabled": false, // ! chat.stickyScroll - Sticky chat - Tắt
  "chat.agent.networkFilter": true, // ? agent.networkFilter - Lọc mạng - Bật
  "chat.unifiedAgentsBar.enabled": true, // ? unifiedAgentsBar - Thanh agent - Bật
  "github.copilot.enable": { // ! Tắt gợi ý (ghost text) của Copilot
    "*": false
  },
  "github.copilot.completions.chat.enabled": true, // * Bật Chat của Copilot
  // ErrorLens - Độc Quyền
  "errorLens.enabledDiagnosticLevels": [
    "error" // ! error - Mức độ - Chỉ lỗi
  ],
  "errorLens.statusBarColorsEnabled": true, // ? statusBarColorsEnabled - Màu status bar - Bật
  // * ------------------------------------------------------------
  // * [`10].TELEMETRY - Dữ liệu, bảo mật, cập nhật extension
  // * ------------------------------------------------------------
  "telemetry.telemetryLevel": "off", // ! telemetryLevel - Telemetry - Tắt
  "telemetry.editStats.showStatusBar": true, // ? editStats.showStatusBar - Thống kê edit - Hiện
  "redhat.telemetry.enabled": false, // ! redhat.telemetry - Telemetry RedHat - Tắt
  "extensions.autoUpdate": "off", // ! autoUpdate - Cập nhật ext - Tắt
  // * ------------------------------------------------------------
  // * [`11].EXTENSION - Cấu hình riêng cho các extension
  // * ------------------------------------------------------------
  //Prettier
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features" // ? defaultFormatter - Formatter - Native JSON
  },
  // Sync Settings (Extension)
  "syncSettings.resources": [ // ? resources - Danh sách tài nguyên đồng bộ
    "extensions",
    "keybindings",
    "settings",
    "snippets",
    "tasks",
    "uiState",
    "mcp"
  ],
  // ? Commit Message Template: <branch> type(scope) profile hostname - [LOG::time] = message
  "syncSettings.gitUpdateMessage": "<main> chore(Update)/{{profile}} {{hostname}} - [LOG::{{now|date:iso}}] = Cập nhật propmt8-ext_SettingSync README.md",
  "syncSettings.gitInitMessage": "<main> feat(Init)/{{profile}} {{hostname}} - [LOG::{{now|date:iso}}] = Khởi tạo project by ext_SettingSync zokugun",
} //``end