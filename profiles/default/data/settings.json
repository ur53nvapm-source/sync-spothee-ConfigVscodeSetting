    "editorHoverWidget.background": "#2d2d2de6", // ? editorHoverWidget.background - Nền tooltip - #2d2d2d (90%)
    "editorHoverWidget.border": "#3c3c3c", // ? editorHoverWidget.border - Viền tooltip - #3c3c3c
    "editorSuggestWidget.background": "#2d2d2de6", // ? editorSuggestWidget.background - Nền gợi ý - #2d2d2d (90%)
    "editorSuggestWidget.border": "#3c3c3c", // ? editorSuggestWidget.border - Viền gợi ý - #3c3c3c
    "editorSuggestWidget.selectedBackground": "#3a3a3a", // ? selectedBackground - Nền item chọn - #3a3a3a
    "inlineChat.background": "#2d2d2de6", // ? inlineChat.background - Nền chat - #2d2d2d (90%)
    "notifications.background": "#2d2d2de6", // ? notifications.background - Nền thông báo - #2d2d2d (90%)
    "notifications.border": "#3c3c3c", // ? notifications.border - Viền thông báo - #3c3c3c
    "notificationCenterHeader.background": "#2d2d2de6", // ? notificationCenterHeader - Nền header - #2d2d2d (90%)
    "quickInput.background": "#2d2d2de6", // ? quickInput.background - Nền Ctrl+P - #2d2d2d (90%)
    "quickInputList.focusBackground": "#3a3a3a", // ? quickInputList.focusBackground - Nền item chọn - #3a3a3a
    // Menu
    "menu.background": "#2d2d2de6", // ? menu.background - Nền menu - #2d2d2d (90%)
    "menu.border": "#3c3c3c", // ? menu.border - Viền menu - #3c3c3c
    "menu.foreground": "#b0b8c0", // ? menu.foreground - Chữ menu - #b0b8c0
    "menu.selectionBackground": "#3a3a3a", // ? menu.selectionBackground - Nền item chọn - #3a3a3a
    "menu.selectionForeground": "#b0b8c0", // ? menu.selectionForeground - Chữ item chọn - #b0b8c0
    "menu.separatorBackground": "#3c3c3c", // ? menu.separatorBackground - Đường phân cách - #3c3c3c
    "menubar.selectionBackground": "#3a3a3a", // ? menubar.selectionBackground - Nền hover - #3a3a3a
    "menubar.selectionForeground": "#b0b8c0", // ? menubar.selectionForeground - Chữ hover - #b0b8c0
    // Activity Bar
    "activityBar.foreground": "#a8b2bb", // ? activityBar.foreground - Icon active - #a8b2bb
    "activityBar.inactiveForeground": "#808080", // ? inactiveForeground - Icon inactive - #808080
    "activityBarBadge.background": "#5c9cd6", // ? activityBarBadge.background - Nền badge - #5c9cd6
    "activityBarBadge.foreground": "#202020", // ? activityBarBadge.foreground - Chữ badge - #202020
    // Status Bar
    "statusBar.background": "#202020f2", // ? statusBar.background - Nền status bar - #202020 (95%)
    "statusBar.foreground": "#88929b", // ? statusBar.foreground - Chữ status bar - #88929b
    "statusBar.border": "#00000000", // ! statusBar.border - Viền status bar - Ẩn
    "statusBar.noFolderBackground": "#202020f2", // ? noFolderBackground - Nền không folder - #202020 (95%)
    "statusBarItem.remoteBackground": "#5c9cd6", // ? remoteBackground - Nền remote - #5c9cd6
    "statusBarItem.remoteForeground": "#202020", // ? remoteForeground - Chữ remote - #202020
    // Title Bar
    "titleBar.activeBackground": "#202020e6", // ? titleBar.activeBackground - Nền active - #202020 (90%)
    "titleBar.inactiveBackground": "#202020cc", // ? titleBar.inactiveBackground - Nền inactive - #202020 (80%)
    "titleBar.activeForeground": "#b8c0c8", // ? titleBar.activeForeground - Chữ active - #b8c0c8
    // Editor Text
    "editor.foreground": "#b0b8c0", // ? editor.foreground - Chữ code - #b0b8c0
    "editorCursor.foreground": "#398a6d9e", // * editorCursor.foreground - Con trỏ - #398a6d
    "editorLineNumber.foreground": "#7c6f64", // ? editorLineNumber.foreground - Số dòng - #7c6f64
    "editorLineNumber.activeForeground": "#e06c75", // * activeForeground - Số dòng active - #e06c75
    "editor.selectionBackground": "#3e4451aa", // ? selectionBackground - Nền bôi đen - #3e4451
    "editor.inactiveSelectionBackground": "#3a3d41aa", // ? inactiveSelectionBackground - Nền bôi đen mất focus - #3a3d41
    // Scrollbar
    "scrollbar.shadow": "#00000000", // ! scrollbar.shadow - Bóng đổ - Ẩn
    "scrollbarSlider.background": "#3c3c3c80", // ? scrollbarSlider.background - Nền thanh trượt - #3c3c3c
    "scrollbarSlider.hoverBackground": "#4c4c4c80", // ? hoverBackground - Nền hover - #4c4c4c
    "scrollbarSlider.activeBackground": "#5c9cd680", // ? activeBackground - Nền kéo - #5c9cd6
